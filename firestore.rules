rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DEV: Allow read/write without auth so Import and app work before adding Firebase Auth.
    // For production: switch to the auth rules below and enable Firebase Authentication.
    match /users/{userId} {
      allow read, write: if true;
    }
    match /products/{productId} {
      allow read, write: if true;
    }
    match /segments/{segmentId} {
      allow read, write: if true;
    }
    match /campaigns/{campaignId} {
      allow read, write: if true;
    }
    match /content/{contentId} {
      allow read, write: if true;
    }
    match /analytics/{analyticsId} {
      allow read, write: if true;
    }
    match /import_jobs/{jobId} {
      allow read, write: if true;
    }
    match /custom/{docId} {
      allow read, write: if true;
    }

    // PRODUCTION (when you enable Firebase Auth): uncomment below and remove the "if true" blocks above
    // match /users/{userId} {
    //   allow read, write: if request.auth != null && request.auth.uid == userId;
    // }
    // match /products/{productId} {
    //   allow read, write: if request.auth != null;
    // }
    // match /segments/{segmentId} { allow read, write: if request.auth != null; }
    // match /campaigns/{campaignId} { allow read, write: if request.auth != null; }
    // match /content/{contentId} { allow read, write: if request.auth != null; }
    // match /analytics/{analyticsId} { allow read, write: if request.auth != null; }
    // match /import_jobs/{jobId} { allow read, write: if request.auth != null; }
  }
}
