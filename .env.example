# App URL for invite links (production). Used when generating invite links.
# VITE_APP_URL=https://your-domain.com

# Προαιρετικό override για HTTP Cloud Functions (connectors OAuth/sync). Πρέπει να είναι
# έγκυρο https URL σε *.cloudfunctions.net (όχι GitHub/raw, όχι hosting rewrite).
# Αν αφήσεις κενό, η εφαρμογή χρησιμοποιεί:
# https://{VITE_FIREBASE_FUNCTIONS_REGION ή europe-west1}-{VITE_FIREBASE_PROJECT_ID ή performance-plus-4a5b2}.cloudfunctions.net
# VITE_FUNCTIONS_BASE_URL=https://europe-west1-performance-plus-4a5b2.cloudfunctions.net

# Sign-up: invite_only (default) = no public registration; new Google accounts only via /invite/ flow.
# Use open only for staging or first-time bootstrap when you need self-serve sign-up.
# VITE_PUBLIC_SIGNUP_MODE=open

# Note: Gemini API key is stored as a Firebase Secret (server-side).
# To set it: firebase functions:secrets:set GEMINI_API_KEY

# Google Search Console site verification token (public — appears in index.html for crawlers).
# Get the value from Google Search Console → Settings → Ownership verification → HTML tag.
# Put the actual value in .env (which is gitignored).
# VITE_GOOGLE_SITE_VERIFICATION=your-token-here
