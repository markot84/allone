# Performance+ — frontend env vars
#
# Two groups of values live here:
#   1. Firebase Web SDK bootstrap (6 keys) + the HTML-substituted Search Console token
#   2. Runtime config (app URL, functions region/base URL, interest-lead URL,
#      public signup mode). These used to live in Firestore `appConfig/publicConfig`
#      but moved back here to keep deploys deterministic.
#
# Backend-only config (lead notification recipients, super-admin allowlist) still
# lives in Firestore — see `.tmp/seed-runtime-config.mjs`.
#
# Get the six SDK values from Firebase Console → Project settings → Your apps.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=performance-plus-4a5b2.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=performance-plus-4a5b2
VITE_FIREBASE_STORAGE_BUCKET=performance-plus-4a5b2.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA v3) site key. Public-by-design but loaded synchronously
# at app start so it cannot come from Firestore. Leave blank to disable App Check.
VITE_RECAPTCHA_V3_SITE_KEY=

# Google Search Console site verification token. Substituted into index.html at
# build time, before any JS runs — cannot be moved to Firestore. Public.
# Source: Google Search Console → Settings → Ownership verification → HTML tag.
VITE_GOOGLE_SITE_VERIFICATION=

# ─── Runtime config ─────────────────────────────────────────────────────────
# Optional. All have safe project-derived defaults; set them only to override.

# Canonical app URL. Default: https://${VITE_FIREBASE_PROJECT_ID}.web.app
VITE_APP_URL=

# Cloud Functions region. Default: europe-west1
VITE_FIREBASE_FUNCTIONS_REGION=

# Override the Cloud Functions base URL. Default is derived from region + project:
# https://{region}-{projectId}.cloudfunctions.net
# Only set this if you proxy functions through a custom domain.
VITE_FUNCTIONS_BASE_URL=

# Override the public interest-lead endpoint. Default: ${functionsBase}/submitInterestLead
VITE_INTEREST_LEAD_URL=

# Sign-up policy. 'invite_only' (default) blocks new Google/email signups unless
# the returnUrl points to /invite/. 'open' lets anyone sign up (staging/bootstrap).
VITE_PUBLIC_SIGNUP_MODE=invite_only
