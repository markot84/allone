# Papaki SMTP — αντιγράψτε σε .env.performance-plus-4a5b2 (ίδιο folder με functions/package.json)
# Στο Plesk «Manual setup» το Outgoing server είναι συχνά το domain (π.χ. performanceplus.gr), όχι linux###.papaki.gr.
# https://support.papaki.com/help/which-settings-should-i-use-in-a-mail-client/
#
# Τα SMTP_EMAIL / SMTP_PASSWORD ορίζονται με: firebase functions:secrets:set
# (το mailbox πρέπει να είναι το ίδιο με το noreply@performanceplus.gr ή όποιο κάνει login στο SMTP)

SMTP_HOST=performanceplus.gr
SMTP_PORT=465
# Εναλλακτικά αν χρειαστεί: linux230.papaki.gr ή SMTP_PORT=587 (STARTTLS)
# Μετά από firebase functions:secrets:set επικόλλησε password χωρίς κενή γραμμή στο τέλος.

# Προαιρετικό (emulator): παραλήπτες ειδοποίησης για νέα leads (comma-separated)
# INTEREST_LEAD_NOTIFY_EMAILS=makis@notthesame.gr,dimitris@notthesame.gr,eleana@notthesame.gr
