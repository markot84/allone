# Papaki SMTP — αντιγράψτε σε .env.performance-plus-4a5b2 (ίδιο folder με functions/package.json)
# Το SMTP host το βρίσκετε στο Papaki (activation email / hosting panel), π.χ. linux109.papaki.gr
# https://support.papaki.com/help/which-settings-should-i-use-in-a-mail-client/
#
# Τα SMTP_EMAIL / SMTP_PASSWORD ορίζονται με: firebase functions:secrets:set
# (το mailbox πρέπει να είναι το ίδιο με το noreply@performanceplus.gr ή όποιο κάνει login στο SMTP)

SMTP_HOST=linux109.papaki.gr
SMTP_PORT=465
