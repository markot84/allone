{
  "name": "performance-",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-build-info.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "firebase:deploy": "npm run build && npx cross-env FUNCTIONS_DISCOVERY_TIMEOUT=90 firebase deploy --only hosting",
    "firebase:deploy:functions": "cd functions && npm run build && cd .. && npx cross-env FUNCTIONS_DISCOVERY_TIMEOUT=90 firebase deploy --only functions",
    "firebase:deploy:full": "npm run build && cd functions && npm run build && cd .. && npx cross-env FUNCTIONS_DISCOVERY_TIMEOUT=90 firebase deploy",
    "deploy:full": "node scripts/deploy-full.mjs",
    "firebase:serve": "npm run build && firebase serve",
    "migrate:brandid": "node scripts/archive/migrate-add-brandid.mjs",
    "fix:user-brand": "node scripts/archive/fix-user-brand.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@primer/octicons-react": "^19.21.2",
    "@primer/react": "^38.7.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/query-sync-storage-persister": "^5.90.22",
    "@tanstack/react-query": "^5.90.19",
    "@tanstack/react-query-persist-client": "^5.90.22",
    "d3-scale": "^4.0.2",
    "firebase": "^11.10.0",
    "framer-motion": "^12.27.1",
    "i18n-iso-countries": "^7.14.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.562.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.2.5",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.6.0",
    "styled-components": "^6.3.8",
    "tailwindcss": "^4.1.18",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/react-simple-maps": "^3.0.6",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-admin": "^13.6.1",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "protobufjs": "^7.5.8",
    "flatted": "^3.4.2",
    "d3-color": "^3.1.0",
    "minimatch@^3.0.0": "^3.1.5",
    "picomatch": "^4.0.4",
    "rollup": "^4.60.4",
    "@grpc/grpc-js": "^1.9.16",
    "brace-expansion": "^1.1.14"
  }
}
